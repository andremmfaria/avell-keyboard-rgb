<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installed to /usr/share/polkit-1/actions/. -->
<policyconfig>
  <vendor>avell-keyboard-rgb</vendor>
  <vendor_url>https://github.com/andremmfaria/avell-keyboard-rgb</vendor_url>
  <action id="io.github.andremmfaria.AvellRgb.control">
    <description>Control the keyboard backlight</description>
    <message>Authentication is required to control the keyboard backlight</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <!--
      The daemon runs as an unprivileged system user and asks polkit about callers that belong
      to other users. Polkit refuses that ("Only trusted callers ... can use CheckAuthorization()
      for subjects belonging to other identities") unless the caller is uid 0 or the action
      owner. The owner must therefore be the daemon user, which has to match the name in
      deploy/avell-keyboard-rgb.sysusers and User= in deploy/avell-rgbd.service
      (deploy/check-deploy.sh and tests/test_deploy_policy.py enforce this).
    -->
    <annotate key="org.freedesktop.policykit.owner">unix-user:avell-rgb</annotate>
  </action>
</policyconfig>
